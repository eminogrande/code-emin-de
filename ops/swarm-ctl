#!/usr/bin/env bash
set -euo pipefail
REPO="/opt/pi-durable-swarm"
LOCKFILE="/run/swarm-ctl.lock"

run_swarm() {
  su -s /bin/bash swarm -c "$1"
}

with_lock() {
  exec 9>"$LOCKFILE"
  if ! flock -w 90 9; then
    echo "swarm-ctl: timed out waiting for deploy lock ($LOCKFILE)" >&2
    exit 1
  fi
}

check_all() {
  for f in "$REPO"/src/*.mjs; do
    node --no-warnings --check "$f"
  done
  run_swarm "cd '$REPO' && node --no-warnings --test test/webauthn.test.mjs"
}

# Guarantee zero secrets / SQLite / keys ever get staged
guard_secrets() {
  local bad
  bad=$(run_swarm "cd '$REPO' && git status --porcelain | awk '{print \$2}' | grep -E '(^\\.env|\\.sqlite|\\.db$|\\.pem$|\\.key$|authorized_keys)' || true")
  if [ -n "$bad" ]; then
    echo "BLOCKED: refusing to stage sensitive file(s): $bad" >&2
    exit 1
  fi
}

backup_to_github() {
  local msg="${1:-chore(vps): verified self-update on code.emin.de}"
  guard_secrets
  run_swarm "
    set -euo pipefail
    cd '$REPO'
    if [ -n \"\$(git status --porcelain)\" ]; then
      git add -A
      git commit -m $(printf '%q' "$msg")
    fi
    git push origin main
  "
}

health_wait() {
  for _ in $(seq 1 15); do
    if [ -S /home/swarm/.pi-durable/swarm.sock ] && curl -fsS http://127.0.0.1:3001/healthz >/dev/null 2>&1; then
      return 0
    fi
    sleep 1
  done
  return 1
}

case "${1:-}" in
  check)
    check_all
    echo "CHECK_OK"
    ;;
  apply|reload)
    with_lock
    chown -R swarm:swarm "$REPO/.git"
    MSG="${2:-chore(vps): verified self-update on code.emin.de}"
    check_all
    PREV_SHA=$(run_swarm "cd '$REPO' && git rev-parse HEAD")
    # Inspect dirty + unpushed files BEFORE committing so we restart only affected services
    DIRTY=$(run_swarm "cd '$REPO' && git status --porcelain src/ ops/ || true")
    UNPUSHED=$(run_swarm "cd '$REPO' && git diff --name-only @{u}..HEAD -- src/ ops/ 2>/dev/null || true")
    TOUCHED=$(printf '%s\n%s\n' "$DIRTY" "$UNPUSHED")
    install -m 644 "$REPO/ops/swarmd.service" /etc/systemd/system/swarmd.service
    install -m 644 "$REPO/ops/swarm-web.service" /etc/systemd/system/swarm-web.service
    if [ -f "$REPO/ops/Caddyfile" ] && ! cmp -s "$REPO/ops/Caddyfile" /etc/caddy/Caddyfile; then
      install -m 644 "$REPO/ops/Caddyfile" /etc/caddy/Caddyfile
      systemctl reload caddy.service || true
    fi
    systemctl daemon-reload
    backup_to_github "$MSG"
    NEW_SHA=$(run_swarm "cd '$REPO' && git rev-parse --short HEAD")
    if echo "$TOUCHED" | grep -qE 'src/(web|webauthn|markdown|worker-meta|chat-client)\.|ops/swarm-web\.service'; then
      systemctl restart swarm-web.service
    fi
    if echo "$TOUCHED" | grep -qE 'src/(daemon|supervisor|models|prompts|triage|bus|optmem|cli|reinforce)\.|ops/swarmd\.service'; then
      # Coalesce background daemon restarts via pidfile so parallel apply calls don't double-restart
      nohup bash -c '
        exec 8>/run/swarmd-restart.lock
        flock -n 8 || exit 0
        sleep 3
        systemctl restart swarmd.service
      ' >/dev/null 2>&1 &
    fi
    if health_wait; then
      echo "APPLIED_AND_BACKED_UP_OK ($NEW_SHA)"
    else
      echo "HEALTHCHECK_FAILED — reverting to $PREV_SHA (forward-only, never force-push)" >&2
      run_swarm "cd '$REPO' && git revert --no-edit HEAD && git push origin main" || true
      systemctl restart swarmd.service swarm-web.service
      exit 1
    fi
    ;;
  reload-web)
    with_lock
    chown -R swarm:swarm "$REPO/.git"
    MSG="${2:-chore(web): verified UI self-update on code.emin.de}"
    check_all
    backup_to_github "$MSG"
    NEW_SHA=$(run_swarm "cd '$REPO' && git rev-parse --short HEAD")
    systemctl restart swarm-web.service
    health_wait
    echo "WEB_APPLIED_AND_BACKED_UP_OK ($NEW_SHA)"
    ;;
  pull)
    with_lock
    chown -R swarm:swarm "$REPO/.git"
    run_swarm "cd '$REPO' && git pull --ff-only origin main && npm ci --omit=dev --ignore-scripts --no-audit --no-fund"
    install -m 644 "$REPO/ops/swarmd.service" /etc/systemd/system/swarmd.service
    install -m 644 "$REPO/ops/swarm-web.service" /etc/systemd/system/swarm-web.service
    if [ -f "$REPO/ops/Caddyfile" ] && ! cmp -s "$REPO/ops/Caddyfile" /etc/caddy/Caddyfile; then
      install -m 644 "$REPO/ops/Caddyfile" /etc/caddy/Caddyfile
      systemctl reload caddy.service || true
    fi
    install -m 755 "$REPO/ops/swarm-ctl" /usr/local/bin/swarm-ctl
    systemctl daemon-reload
    check_all
    systemctl restart swarmd.service swarm-web.service
    health_wait
    echo "PULLED_OK"
    ;;
  status)
    systemctl --no-pager -l status swarmd.service swarm-web.service caddy.service | head -n 45
    ;;
  rollback)
    with_lock
    TARGET="${2:-HEAD~1}"
    run_swarm "cd '$REPO' && git revert --no-edit '$TARGET' && git push origin main"
    check_all
    systemctl restart swarmd.service swarm-web.service
    health_wait
    echo "ROLLED_BACK_OK"
    ;;
  *)
    echo "Usage: swarm-ctl {check|apply [msg]|reload-web [msg]|pull|rollback [commit]|status}" >&2
    exit 1
    ;;
esac
