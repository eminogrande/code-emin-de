#!/usr/bin/env bash
set -euo pipefail
REPO="/opt/pi-durable-swarm"

run_swarm() {
  su -s /bin/bash swarm -c "$1"
}

check_all() {
  for f in "$REPO"/src/*.mjs; do
    node --no-warnings --check "$f"
  done
  run_swarm "cd '$REPO' && node --no-warnings --test test/webauthn.test.mjs"
}

# Guarantee zero secrets / SQLite / keys ever get staged
guard_secrets() {
  local bad
  bad=$(run_swarm "cd '$REPO' && git status --porcelain | awk '{print \$2}' | grep -E '(^\\.env|\\.sqlite|\\.pem$|\\.key$|authorized_keys)' || true")
  if [ -n "$bad" ]; then
    echo "BLOCKED: refusing to stage sensitive file(s): $bad" >&2
    exit 1
  fi
}

backup_to_github() {
  local msg="${1:-chore(vps): verified self-update on code.emin.de}"
  guard_secrets
  run_swarm "
    set -euo pipefail
    cd '$REPO'
    if [ -n \"\$(git status --porcelain)\" ]; then
      git add -A
      git commit -m $(printf '%q' "$msg")
    fi
    git push origin main
  "
}

health_wait() {
  for _ in $(seq 1 15); do
    if [ -S /home/swarm/.pi-durable/swarm.sock ] && curl -fsS http://127.0.0.1:3001/healthz >/dev/null 2>&1; then
      return 0
    fi
    sleep 1
  done
  return 1
}

case "${1:-}" in
  check)
    check_all
    echo "CHECK_OK"
    ;;
  apply|reload)
    MSG="${2:-chore(vps): verified self-update on code.emin.de}"
    check_all
    PREV_SHA=$(run_swarm "cd '$REPO' && git rev-parse HEAD")
    # Sync systemd/caddy ops files if edited inside repo
    install -m 644 "$REPO/ops/swarmd.service" /etc/systemd/system/swarmd.service
    install -m 644 "$REPO/ops/swarm-web.service" /etc/systemd/system/swarm-web.service
    systemctl daemon-reload
    # Restart ONLY swarm-web first when called from inside swarmd so agent turn isn't killed mid-push;
    # schedule swarmd restart in background if daemon files changed!
    CHANGED=$(run_swarm "cd '$REPO' && git status --porcelain src/ ops/" || true)
    backup_to_github "$MSG"
    NEW_SHA=$(run_swarm "cd '$REPO' && git rev-parse --short HEAD")
    systemctl restart swarm-web.service
    if echo "$CHANGED" | grep -qvE '^.. src/web(authn)?\.mjs$'; then
      # Restart swarmd cleanly 1s after returning so active tool call can finish
      nohup bash -c 'sleep 1 && systemctl restart swarmd.service' >/dev/null 2>&1 &
    fi
    if health_wait; then
      echo "APPLIED_AND_BACKED_UP_OK ($NEW_SHA)"
    else
      echo "HEALTHCHECK_FAILED — rolling back to $PREV_SHA" >&2
      run_swarm "cd '$REPO' && git reset --hard '$PREV_SHA' && git push --force-with-lease origin main" || true
      systemctl restart swarmd.service swarm-web.service
      exit 1
    fi
    ;;
  reload-web)
    MSG="${2:-chore(web): verified UI self-update on code.emin.de}"
    check_all
    backup_to_github "$MSG"
    NEW_SHA=$(run_swarm "cd '$REPO' && git rev-parse --short HEAD")
    systemctl restart swarm-web.service
    health_wait
    echo "WEB_APPLIED_AND_BACKED_UP_OK ($NEW_SHA)"
    ;;
  pull)
    run_swarm "cd '$REPO' && git pull --ff-only origin main && npm ci --omit=dev --ignore-scripts --no-audit --no-fund"
    check_all
    systemctl restart swarmd.service swarm-web.service
    health_wait
    echo "PULLED_OK"
    ;;
  status)
    systemctl --no-pager -l status swarmd.service swarm-web.service caddy.service | head -n 45
    ;;
  *)
    echo "Usage: swarm-ctl {check|apply [msg]|reload-web [msg]|pull|status}" >&2
    exit 1
    ;;
esac
